<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SÓC SƠN OLYMPIA - Pixel Quiz Game</title>
  <!-- Google Fonts: Pixel Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tone.js for Sound Effects -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

  <style>
    /* Custom Pixel Art Styles & Aesthetics */
    * {
      image-rendering: pixelated;
      user-select: none;
    }

    body {
      font-family: 'Press Start 2P', monospace;
      background-color: #0d1b2a;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    }

    /* Pixel Art Container Box */
    .game-container {
      position: relative;
      width: 100%;
      max-width: 960px;
      height: 600px;
      background: linear-gradient(to bottom, #a7d8de 0%, #c4ebd0 70%, #8acb88 85%);
      border: 8px solid #3a1a04;
      border-radius: 12px;
      box-shadow: 0 0 0 6px #8c4c14, 0 20px 40px rgba(0,0,0,0.6);
      overflow: hidden;
    }

    /* Ground Layer */
    .pixel-ground {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 70px;
      background-color: #5c3818;
      border-top: 14px solid #48a02c;
      background-image: 
        radial-gradient(#3a200b 20%, transparent 20%),
        radial-gradient(#2b1605 20%, transparent 20%);
      background-size: 16px 16px;
      background-position: 0 0, 8px 8px;
      z-index: 10;
    }

    /* Retro Pixel Buttons */
    .pixel-btn {
      font-family: 'Press Start 2P', monospace;
      background-color: #d96b27;
      color: #ffffff;
      border: 4px solid #3a1a04;
      box-shadow: inset -4px -4px 0px #9e3d09, inset 4px 4px 0px #fca34d, 0 6px 0px #240e02;
      border-radius: 8px;
      transition: all 0.1s ease;
      cursor: pointer;
      text-shadow: 2px 2px 0px #3a1a04;
      position: relative;
    }

    .pixel-btn:hover:not(:disabled) {
      background-color: #e87933;
      transform: translateY(-2px);
      box-shadow: inset -4px -4px 0px #9e3d09, inset 4px 4px 0px #fdba74, 0 8px 0px #240e02;
    }

    .pixel-btn:active:not(:disabled) {
      transform: translateY(4px);
      box-shadow: inset -4px -4px 0px #fca34d, inset 4px 4px 0px #9e3d09, 0 2px 0px #240e02;
    }

    .pixel-btn-correct {
      background-color: #22c55e !important;
      border-color: #14532d !important;
      color: #ffffff !important;
      box-shadow: inset -4px -4px 0px #15803d, inset 4px 4px 0px #86efac, 0 6px 0px #052e16 !important;
    }

    .pixel-btn-wrong {
      background-color: #ef4444 !important;
      border-color: #7f1d1d !important;
      color: #ffffff !important;
      box-shadow: inset -4px -4px 0px #b91c1c, inset 4px 4px 0px #fca5a5, 0 6px 0px #450a0a !important;
    }

    /* Pixel Box Overlay */
    .pixel-card {
      background-color: rgba(255, 255, 255, 0.92);
      border: 6px solid #3a1a04;
      border-radius: 10px;
      box-shadow: inset -4px -4px 0px #cbd5e1, inset 4px 4px 0px #ffffff, 0 8px 16px rgba(0,0,0,0.3);
    }

    /* Floating Animations */
    @keyframes floatClouds {
      0% { transform: translateX(0px); }
      50% { transform: translateX(20px); }
      100% { transform: translateX(0px); }
    }

    .animate-cloud {
      animation: floatClouds 6s ease-in-out infinite;
    }

    @keyframes flickerFire {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.08); }
    }

    .animate-fire {
      animation: flickerFire 0.4s infinite alternate;
    }
  </style>
</head>
<body>

  <!-- GAME CONTAINER MAIN -->
  <div class="game-container flex flex-col justify-between" id="gameScreen">

    <!-- TOP HEADER / HUD -->
    <div class="relative z-20 flex justify-between items-center p-4">
      <!-- Title Badge / Level Indicator -->
      <div class="pixel-card px-3 py-2 text-xs md:text-sm text-amber-900 font-bold flex items-center gap-2">
        <span class="inline-block w-3 h-3 bg-red-600 rounded-full animate-ping"></span>
        <span id="levelIndicator">THPT SÓC SƠN OLYMPIA</span>
      </div>

      <!-- Hearts Health Bar (5 Pixel Hearts) -->
      <div class="flex items-center space-x-1" id="heartsContainer">
        <!-- SVG Pixel Hearts Rendered via JS -->
      </div>
    </div>

    <!-- BACKGROUND GRAPHICS LAYER -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <!-- Sun -->
      <svg class="absolute top-6 left-1/2 transform -translate-x-1/2 w-16 h-16" viewBox="0 0 16 16">
        <rect x="2" y="2" width="12" height="12" fill="#FBBF24" />
        <rect x="0" y="6" width="16" height="4" fill="#F59E0B" />
        <rect x="6" y="0" width="4" height="16" fill="#F59E0B" />
        <rect x="4" y="4" width="8" height="8" fill="#FEF08A" />
      </svg>

      <!-- Clouds Left & Right -->
      <svg class="absolute top-8 left-10 w-24 h-12 animate-cloud" viewBox="0 0 24 12">
        <rect x="4" y="4" width="16" height="6" fill="#FFFFFF" />
        <rect x="6" y="2" width="10" height="8" fill="#FFFFFF" />
        <rect x="2" y="6" width="20" height="4" fill="#E2E8F0" />
      </svg>
      <svg class="absolute top-12 right-16 w-28 h-14 animate-cloud" style="animation-delay: 2s;" viewBox="0 0 24 12">
        <rect x="4" y="4" width="16" height="6" fill="#FFFFFF" />
        <rect x="6" y="2" width="10" height="8" fill="#FFFFFF" />
        <rect x="2" y="6" width="20" height="4" fill="#CBD5E1" />
      </svg>

      <!-- Flying Duck / Bird -->
      <svg class="absolute top-16 left-1/3 w-8 h-6 animate-pulse" viewBox="0 0 12 8">
        <rect x="2" y="2" width="6" height="3" fill="#1E40AF" />
        <rect x="6" y="0" width="3" height="3" fill="#3B82F6" />
        <rect x="9" y="1" width="2" height="2" fill="#F97316" />
        <rect x="0" y="3" width="4" height="2" fill="#1D4ED8" />
      </svg>

      <!-- Left Pixel Mountain -->
      <svg class="absolute bottom-16 left-0 w-44 h-56" viewBox="0 0 100 120" preserveAspectRatio="none">
        <polygon points="0,120 40,30 60,60 100,120" fill="#64748B" />
        <polygon points="0,120 30,40 45,70 70,120" fill="#475569" />
        <polygon points="40,30 48,45 35,45" fill="#F8FAFC" />
      </svg>

      <!-- Right Pixel Tree -->
      <svg class="absolute bottom-16 right-4 w-36 h-48" viewBox="0 0 40 50">
        <!-- Leaves -->
        <rect x="8" y="4" width="24" height="24" fill="#15803D" />
        <rect x="12" y="0" width="16" height="28" fill="#22C55E" />
        <rect x="4" y="8" width="32" height="16" fill="#166534" />
        <!-- Trunk -->
        <rect x="16" y="28" width="8" height="22" fill="#78350F" />
        <rect x="18" y="28" width="4" height="22" fill="#9A3412" />
      </svg>

      <!-- Pixel Knight / Student Character (Left) -->
      <svg class="absolute bottom-14 left-10 w-16 h-24" viewBox="0 0 16 24">
        <!-- Hair -->
        <rect x="4" y="2" width="8" height="4" fill="#FDE047" />
        <!-- Face -->
        <rect x="4" y="6" width="8" height="5" fill="#FFEDD5" />
        <rect x="5" y="7" width="2" height="2" fill="#1E293B" />
        <rect x="9" y="7" width="2" height="2" fill="#1E293B" />
        <!-- Shirt -->
        <rect x="3" y="11" width="10" height="6" fill="#EA580C" />
        <rect x="4" y="17" width="8" height="2" fill="#CA8A04" />
        <!-- Pants / Boots -->
        <rect x="4" y="19" width="3" height="4" fill="#1E3A8A" />
        <rect x="9" y="19" width="3" height="4" fill="#1E3A8A" />
      </svg>

      <!-- Campfire (Center Left) -->
      <svg class="absolute bottom-14 left-44 w-10 h-10 animate-fire" viewBox="0 0 16 16">
        <!-- Wood -->
        <rect x="2" y="12" width="12" height="3" fill="#78350F" />
        <!-- Flame -->
        <rect x="6" y="6" width="4" height="6" fill="#EF4444" />
        <rect x="7" y="4" width="2" height="4" fill="#F97316" />
        <rect x="7" y="8" width="2" height="2" fill="#FDE047" />
      </svg>

      <!-- Black Cat Character (Right) -->
      <svg class="absolute bottom-14 right-36 w-14 h-16" viewBox="0 0 16 18">
        <!-- Ears -->
        <rect x="3" y="2" width="3" height="3" fill="#1E293B" />
        <rect x="10" y="2" width="3" height="3" fill="#1E293B" />
        <!-- Head -->
        <rect x="3" y="4" width="10" height="7" fill="#0F172A" />
        <!-- Yellow Eyes -->
        <rect x="5" y="6" width="2" height="2" fill="#FACC15" />
        <rect x="9" y="6" width="2" height="2" fill="#FACC15" />
        <!-- Body -->
        <rect x="4" y="11" width="8" height="6" fill="#0F172A" />
        <!-- Tail -->
        <rect x="12" y="13" width="3" height="2" fill="#0F172A" />
      </svg>
    </div>

    <!-- MAIN INTERACTIVE CONTENT AREA -->
    <div class="relative z-20 flex-1 flex flex-col justify-center items-center px-4 py-2">
      
      <!-- 1. START MENU SCREEN -->
      <div id="startScreen" class="w-full max-w-lg text-center flex flex-col items-center">
        <div class="pixel-card p-6 w-full mb-6">
          <h1 class="text-2xl md:text-3xl font-extrabold text-amber-900 tracking-wider mb-2 drop-shadow">
            NIGHT GAME
          </h1>
          <p class="text-xs md:text-sm text-orange-800 font-bold mb-1">TRƯỜNG THPT SÓC SƠN</p>
          <p class="text-xs text-slate-600 font-bold">Hành Trình Tìm Hiểu Truyền Thống</p>
        </div>

        <div class="flex flex-col space-y-4 w-64">
          <button onclick="startGame()" class="pixel-btn py-3 text-sm font-bold">
            LET'S PLAY
          </button>
          <button onclick="showInstructions()" class="pixel-btn py-3 text-sm font-bold">
            HƯỚNG DẪN
          </button>
        </div>
      </div>

      <!-- 2. INSTRUCTIONS SCREEN -->
      <div id="instructionsScreen" class="hidden w-full max-w-lg text-center">
        <div class="pixel-card p-6 text-left mb-4">
          <h2 class="text-base font-bold text-amber-900 mb-4 text-center">HƯỚNG DẪN CHƠI</h2>
          <ul class="text-xs text-slate-800 space-y-2 leading-relaxed">
            <li>• Bạn có <strong>5 Trái Tim (Máu)</strong> đại diện cho 5 cơ hội.</li>
            <li>• Có tất cả <strong>6 Câu hỏi trắc nghiệm</strong> về truyền thống nhà trường THPT Sóc Sơn.</li>
            <li>• Trả lời sai sẽ mất <strong>1 Trái tim</strong>. Hết tim game sẽ kết thúc!</li>
            <li>• Hãy vượt qua tất cả câu hỏi để giành chiến thắng cao nhất!</li>
          </ul>
        </div>
        <button onclick="showStartScreen()" class="pixel-btn py-3 px-8 text-xs font-bold">
          TRỞ VỀ
        </button>
      </div>

      <!-- 3. QUIZ QUESTION SCREEN -->
      <div id="quizScreen" class="hidden w-full max-w-2xl flex flex-col items-center">
        <!-- Question Box -->
        <div class="pixel-card p-4 md:p-6 w-full mb-4 text-left">
          <div class="text-xs text-amber-700 font-bold mb-2" id="questionNumber">
            CÂU HỎI 1/6
          </div>
          <div class="text-xs md:text-sm text-slate-900 font-semibold leading-relaxed" id="questionText">
            Nội dung câu hỏi ở đây...
          </div>
        </div>

        <!-- Options Container (4 Buttons) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 w-full mb-4" id="optionsGrid">
          <!-- Rendered dynamically -->
        </div>

        <!-- Explanation / Feedback Banner -->
        <div id="feedbackBanner" class="hidden pixel-card p-3 w-full text-center text-xs font-bold transition-all">
          <div id="feedbackText" class="mb-1"></div>
          <div id="explanationText" class="text-[10px] text-slate-700 font-normal"></div>
          <button onclick="nextQuestion()" class="pixel-btn py-2 px-6 text-xs mt-2">
            CÂU TIẾP THEO ➔
          </button>
        </div>
      </div>

      <!-- 4. END GAME RESULT SCREEN -->
      <div id="resultScreen" class="hidden w-full max-w-lg text-center">
        <div class="pixel-card p-6 mb-6">
          <h2 id="resultTitle" class="text-xl font-bold mb-2">VICTORY!</h2>
          <p id="resultSubtitle" class="text-xs text-slate-700 mb-4">Bạn thật xuất sắc!</p>
          
          <div class="text-sm font-bold text-amber-900 mb-2">
            ĐIỂM SỐ: <span id="finalScore" class="text-red-600">6/6</span>
          </div>
          <div class="text-xs text-slate-600" id="heartsRemainingText">
            Số tim còn lại: 5/5
          </div>
        </div>

        <button onclick="startGame()" class="pixel-btn py-3 px-8 text-xs font-bold">
          CHƠI LẠI
        </button>
      </div>

    </div>

    <!-- BOTTOM GROUND LAYER -->
    <div class="pixel-ground"></div>
  </div>

  <!-- JAVASCRIPT GAME LOGIC -->
  <script>
    // 6 QUESTION DATASET
    const quizData = [
      {
        question: "Truyền thống nào được xem là một trong những giá trị cốt lõi mà các thế hệ thầy và trò Trường THPT Sóc Sơn luôn gìn giữ?",
        options: [
          "A. Đoàn kết, hiếu học, vượt khó, thi đua dạy tốt – học tốt.",
          "B. Chỉ chú trọng thành tích trong các kỳ thi.",
          "C. Ưu tiên hoạt động vui chơi, giải trí.",
          "D. Chỉ quan tâm đến kết quả học tập cá nhân."
        ],
        correct: 0,
        explanation: "Đoàn kết, hiếu học, vượt khó, thi đua dạy tốt – học tốt là cốt lõi truyền thống lâu đời của trường."
      },
      {
        question: "Là học sinh Trường THPT Sóc Sơn, hành động nào sau đây thiết thực nhất để phát huy truyền thống nhà trường?",
        options: [
          "A. Chỉ cần đạt điểm cao trong các bài kiểm tra.",
          "B. Tích cực học tập, rèn luyện đạo đức, đoàn kết và tham gia hoạt động tập thể.",
          "C. Chỉ tham gia các hoạt động khi được giáo viên yêu cầu.",
          "D. Quan tâm đến thành tích cá nhân mà không cần quan tâm đến tập thể."
        ],
        correct: 1,
        explanation: "Rèn luyện toàn diện cả đạo đức, tri thức và tinh thần tập thể là hành động thiết thực nhất."
      },
      {
        question: "Thành tích đặc biệt nổi nổi bật nào của Trường THPT Sóc Sơn gắn với chương trình Đường lên đỉnh Olympia?",
        options: [
          "A. Hai lần đưa cầu truyền hình trực tiếp về với nhà trường.",
          "B. Có học sinh đạt giải Nhất cuộc thi cấp trường.",
          "C. Có học sinh tham gia vòng thi cấp huyện.",
          "D. Được tổ chức cuộc thi Olympia thường niên."
        ],
        correct: 0,
        explanation: "THPT Sóc Sơn tự hào 2 lần đưa cầu truyền hình chung kết Đường lên đỉnh Olympia về trường."
      },
      {
        question: "Phân hiệu Phù Lỗ – tiền thân của Trường THPT Sóc Sơn – được thành lập vào ngày nào?",
        options: [
          "A. 19/9/1983.",
          "B. 20/11/1983.",
          "C. 03/01/1985.",
          "D. 24/9/1985."
        ],
        correct: 0,
        explanation: "Ngày 19/9/1983 là mốc lịch sử thành lập Phân hiệu Phù Lỗ, tiền thân THPT Sóc Sơn."
      },
      {
        question: "What can students do to preserve the good traditions of Soc Son High School?",
        options: [
          "A. Respect teachers, follow school rules and help their classmates.",
          "B. Ignore school activities and only focus on personal interests.",
          "C. Disobey school rules and avoid group activities.",
          "D. Forget the school's history and traditions."
        ],
        correct: 0,
        explanation: "Respecting teachers, obeying rules, and helping friends help uphold traditions."
      },
      {
        question: "Why is it essential for students to inherit and uphold the traditional values of Soc Son High School?",
        options: [
          "A. To prioritize individual achievements over collective development.",
          "B. To strengthen their sense of pride, responsibility and commitment to preserving the school's cultural heritage.",
          "C. To replace all traditional activities with modern trends.",
          "D. To reduce students' participation in community activities."
        ],
        correct: 1,
        explanation: "Upholding traditions builds school pride, responsibility, and preserves cultural heritage."
      }
    ];

    // GAME STATE VARIABLES
    let currentQuestionIndex = 0;
    let score = 0;
    let lives = 5;
    let answerSelected = false;

    // TONE.JS SOUND SYNTHS
    const correctSynth = new Tone.Synth({
      oscillator: { type: "square" },
      envelope: { attack: 0.01, decay: 0.1, sustain: 0.1, release: 0.1 }
    }).toDestination();

    const wrongSynth = new Tone.Synth({
      oscillator: { type: "sawtooth" },
      envelope: { attack: 0.01, decay: 0.2, sustain: 0, release: 0.2 }
    }).toDestination();

    function playSound(isCorrect) {
      Tone.start();
      if (isCorrect) {
        correctSynth.triggerAttackRelease("E5", "16n", Tone.now());
        correctSynth.triggerAttackRelease("G5", "16n", Tone.now() + 0.08);
      } else {
        wrongSynth.triggerAttackRelease("C3", "8n", Tone.now());
      }
    }

    // INITIAL RENDER
    window.onload = function() {
      renderHearts();
    };

    // RENDER LIVES (HEARTS)
    function renderHearts() {
      const container = document.getElementById('heartsContainer');
      container.innerHTML = '';
      for (let i = 0; i < 5; i++) {
        const isFilled = i < lives;
        container.innerHTML += `
          <svg class="w-6 h-6 md:w-7 md:h-7" viewBox="0 0 16 16">
            <path fill="${isFilled ? '#EF4444' : '#64748B'}" d="M2 3 h4 v2 h-4 z M10 3 h4 v2 h-4 z M0 5 h8 v2 h-8 z M8 5 h8 v2 h-8 z M0 7 h16 v4 h-16 z M2 11 h12 v2 h-12 z M4 13 h8 v2 h-8 z M6 15 h4 v1 h-4 z" />
            <path fill="${isFilled ? '#FCA5A5' : '#94A3B8'}" d="M3 4 h1 v1 h-1 z" />
          </svg>
        `;
      }
    }

    // SCREEN NAVIGATION
    function showStartScreen() {
      document.getElementById('startScreen').classList.remove('hidden');
      document.getElementById('instructionsScreen').classList.add('hidden');
      document.getElementById('quizScreen').classList.add('hidden');
      document.getElementById('resultScreen').classList.add('hidden');
    }

    function showInstructions() {
      document.getElementById('startScreen').classList.add('hidden');
      document.getElementById('instructionsScreen').classList.remove('hidden');
    }

    // START / RESTART GAME
    function startGame() {
      currentQuestionIndex = 0;
      score = 0;
      lives = 5;
      answerSelected = false;
      renderHearts();

      document.getElementById('startScreen').classList.add('hidden');
      document.getElementById('instructionsScreen').classList.add('hidden');
      document.getElementById('resultScreen').classList.add('hidden');
      document.getElementById('quizScreen').classList.remove('hidden');

      loadQuestion();
    }

    // LOAD CURRENT QUESTION
    function loadQuestion() {
      answerSelected = false;
      const q = quizData[currentQuestionIndex];

      document.getElementById('questionNumber').innerText = `CÂU HỎI ${currentQuestionIndex + 1}/6`;
      document.getElementById('questionText').innerText = q.question;
      
      const feedbackBanner = document.getElementById('feedbackBanner');
      feedbackBanner.classList.add('hidden');

      const optionsGrid = document.getElementById('optionsGrid');
      optionsGrid.innerHTML = '';

      q.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = 'pixel-btn text-left p-3 text-xs leading-relaxed font-semibold';
        btn.innerText = opt;
        btn.onclick = () => selectOption(index);
        optionsGrid.appendChild(btn);
      });
    }

    // OPTION SELECTION LOGIC
    function selectOption(selectedIndex) {
      if (answerSelected) return;
      answerSelected = true;

      const q = quizData[currentQuestionIndex];
      const isCorrect = selectedIndex === q.correct;
      const buttons = document.getElementById('optionsGrid').children;

      // Play retro sound effect
      playSound(isCorrect);

      if (isCorrect) {
        score++;
        buttons[selectedIndex].classList.add('pixel-btn-correct');
      } else {
        lives--;
        renderHearts();
        buttons[selectedIndex].classList.add('pixel-btn-wrong');
        // Highlight the correct answer
        buttons[q.correct].classList.add('pixel-btn-correct');
      }

      // Show Feedback Banner
      const feedbackBanner = document.getElementById('feedbackBanner');
      const feedbackText = document.getElementById('feedbackText');
      const explanationText = document.getElementById('explanationText');

      feedbackBanner.classList.remove('hidden');
      if (isCorrect) {
        feedbackText.innerText = "★ CHÍNH XÁC! ★";
        feedbackText.className = "text-green-700 font-bold mb-1";
      } else {
        feedbackText.innerText = "✖ SAI RỒI! ✖";
        feedbackText.className = "text-red-600 font-bold mb-1";
      }
      explanationText.innerText = q.explanation;

      // Check Game Over (Lives = 0)
      if (lives <= 0) {
        setTimeout(showResultScreen, 1800);
      }
    }

    // NEXT QUESTION OR FINISH
    function nextQuestion() {
      if (lives <= 0) {
        showResultScreen();
        return;
      }

      currentQuestionIndex++;
      if (currentQuestionIndex < quizData.length) {
        loadQuestion();
      } else {
        showResultScreen();
      }
    }

    // SHOW FINAL RESULT SCREEN
    function showResultScreen() {
      document.getElementById('quizScreen').classList.add('hidden');
      document.getElementById('resultScreen').classList.remove('hidden');

      const resultTitle = document.getElementById('resultTitle');
      const resultSubtitle = document.getElementById('resultSubtitle');
      const finalScore = document.getElementById('finalScore');
      const heartsRemainingText = document.getElementById('heartsRemainingText');

      finalScore.innerText = `${score}/6`;
      heartsRemainingText.innerText = `Số tim còn lại: ${lives}/5`;

      if (lives > 0 && score >= 4) {
        resultTitle.innerText = "VICTORY!";
        resultTitle.className = "text-xl font-bold mb-2 text-green-700";
        resultSubtitle.innerText = "Bạn là niềm tự hào của THPT Sóc Sơn!";
      } else {
        resultTitle.innerText = "GAME OVER!";
        resultTitle.className = "text-xl font-bold mb-2 text-red-600";
        resultSubtitle.innerText = "Hãy thử lại để hiểu rõ hơn về trường nhé!";
      }
    }
  </script>
</body>
</html>
